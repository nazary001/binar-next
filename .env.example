# Copy to .env.local (gitignored) and fill in. Never commit real values.

# MongoDB Atlas, runtime user of the site (readWrite on the database below).
# On Vercel use the SRV form: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Locally the standard form with the three hosts also works when SRV lookups fail.
MONGODB_URI=
MONGODB_DB=binar

# Optional, LOCAL ONLY: an admin user for `npm run db:setup` (collection
# validators need collMod). Do not add it to Vercel.
MONGODB_ADMIN_URI=

# Password given to the two demo accounts by `npm run db:seed`.
SEED_DEMO_PASSWORD=

# Shared secret of POST /api/revalidate (header x-revalidate-secret).
REVALIDATE_SECRET=

# Optional, LOCAL ONLY: 1 enables the audit helpers under /api/dev/* and
# switches rate limits off. Ignored in production builds and on Vercel.
# BINAR_TEST_MODE=1

# --- Admin panel (/admin) ---------------------------------------------------
# Optional: 32 random bytes (64 hex characters or base64) that seal the
# secrets the panel stores in the database (carrier key, ERP password, mail
# key). Without it the key is derived from REVALIDATE_SECRET. Changing either
# means the stored secrets must be typed in again.
# SECRETS_KEY=

# Optional: the public address used in links of outgoing mail
# (default https://binar-2000.com; http://localhost:3000 in development).
# SITE_URL=

# LOCAL ONLY. Local development runs on a copy of the database so nothing
# typed or tested locally reaches the live data: create
# .env.development.local with MONGODB_URI (the admin connection) and
# MONGODB_DB=binar_dev, then `npm run db:clone-dev` and `npm run db:setup:dev`.
# The first panel account: `npm run admin:create:dev -- --email you@example.com --name "Name"`.

# Optional: a long random string that opens GET /api/cron/outbox (one run of
# the mailer: retries of failed messages) to a scheduler sending
# "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends exactly that).
# Not set = the route answers 404. Mail is sent without it too: right after
# each request that writes a message, and while the panel is in use.
# CRON_SECRET=
